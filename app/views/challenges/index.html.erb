<% content_for :title, "Challenges" %>

<header class="row row--between mb-3">
  <div>
    <h1 class="mb-0">Challenges</h1>
    <p class="text-muted text-sm mb-0">
      Each shape proves a different mastery dimension.
    </p>
  </div>
</header>

<form class="card mb-3" method="get" action="<%= challenges_path %>"
      data-controller="autosubmit" data-action="change->autosubmit#submit">
  <div class="row">
    <div class="field" style="margin: 0; min-width: 190px;">
      <label for="type-filter">Shape</label>
      <select class="select" id="type-filter" name="type">
        <option value="">All shapes</option>
        <% Challenge::CHALLENGE_TYPES.keys.each do |type| %>
          <option value="<%= type %>" <%= "selected" if params[:type] == type.to_s %>>
            <%= type.to_s.humanize %>
          </option>
        <% end %>
      </select>
    </div>
    <div class="field" style="margin: 0; min-width: 190px;">
      <label for="skill-filter">Skill</label>
      <select class="select" id="skill-filter" name="skill_id">
        <option value="">All skills</option>
        <% @skills.each do |skill| %>
          <option value="<%= skill.id %>" <%= "selected" if params[:skill_id] == skill.id.to_s %>>
            <%= skill.name %>
          </option>
        <% end %>
      </select>
    </div>
    <noscript><button class="btn mt-2" type="submit">Filter</button></noscript>
  </div>
</form>

<% if @challenges.any? %>
  <div class="stack stack--tight">
    <% @challenges.each do |challenge| %>
      <%= link_to challenge_path(challenge.slug), class: "card",
                  style: "display: block; text-decoration: none;" do %>
        <div class="row row--between">
          <div style="min-width: 0;">
            <div class="row" style="gap: 0.4rem;">
              <strong><%= challenge.title %></strong>
              <% if @solved_ids.include?(challenge.id) %>
                <span class="badge badge--success">Solved</span>
              <% end %>
            </div>
            <div class="text-sm text-muted mt-1"><%= challenge.prompt.lines.first.to_s.truncate(130) %></div>
            <div class="row text-xs text-faint mt-1">
              <span><%= challenge.challenge_type.to_s.humanize %></span>
              <span aria-hidden="true">·</span>
              <span><%= challenge.skill&.name %></span>
              <span aria-hidden="true">·</span>
              <span><%= challenge.challenge_tests.size %> tests</span>
            </div>
          </div>
          <div class="stack stack--tight text-center" style="flex: 0 0 auto;">
            <span class="badge"><%= challenge.difficulty_label %></span>
            <span class="badge badge--accent">+<%= challenge.xp_award %></span>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="mt-3"><%= paginate @challenges %></div>
<% else %>
  <div class="empty">
    <div class="empty__icon" aria-hidden="true">⬢</div>
    <p class="mb-0">No challenges match those filters.</p>
  </div>
<% end %>
