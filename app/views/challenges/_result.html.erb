<%
  heading ||= nil
  result ||= nil
  xp ||= nil
  tests = result ? result.tests : attempt.test_results.map(&:symbolize_keys)
  message = result&.message || attempt.stderr
%>
<section class="card card--flush" aria-live="polite">
  <div class="card__header">
    <h2 class="mb-0"><%= heading || "Result" %></h2>
    <span class="badge badge--<%= attempt.passed? ? "success" : "danger" %>"
          style="margin-left: auto;">
      <%= attempt.status.humanize %>
    </span>
  </div>

  <div class="card__body">
    <div class="row row--between mb-2">
      <div style="flex: 1; max-width: 340px;">
        <div class="meter <%= attempt.passed? ? "meter--success" : "meter--danger" %>">
          <div class="meter__fill" style="width: <%= attempt.score_percent %>%"></div>
        </div>
        <span class="text-xs text-faint">
          <%= attempt.tests_passed %> of <%= attempt.tests_total %> tests passing
          <% if attempt.runtime_ms %> · <%= attempt.runtime_ms %>ms<% end %>
        </span>
      </div>
      <% if xp.to_i.positive? %>
        <span class="badge badge--accent">+<%= xp %> XP</span>
      <% end %>
    </div>

    <% if message.present? %>
      <div class="terminal mb-2"><%= message %></div>
    <% end %>

    <% if tests.any? %>
      <div class="terminal mb-2"><% tests.each do |test| %><span class="terminal__line--<%= test[:passed] ? "pass" : "fail" %>"><%= test[:passed] ? "  ✓ " : "  ✗ " %><%= test[:name] %></span>
<% unless test[:passed] %><% if test[:error] %><span class="terminal__line--muted">      <%= test[:error]["class"] %>: <%= test[:error]["message"] %></span>
<% else %><span class="terminal__line--muted">      expected <%= test[:expected] %>, got <%= test[:actual] %></span>
<% end %><% end %><% end %></div>
    <% end %>

    <% if result&.stdout.present? %>
      <h3 class="text-sm">Your output</h3>
      <div class="terminal mb-2"><%= result.stdout %></div>
    <% end %>

    <%# Automated review (spec 56): heuristics, labelled as such. %>
    <% findings = attempt.review_findings %>
    <% if findings.any? || attempt.review["estimated_complexity"].present? %>
      <h3 class="text-sm mt-3">Automated review</h3>
      <% if attempt.review["estimated_complexity"].present? %>
        <p class="text-xs text-muted mb-2">
          Estimated complexity:
          <strong class="mono"><%= attempt.review["estimated_complexity"] %></strong>
          · <%= attempt.review["line_count"] %> lines
        </p>
      <% end %>
      <div class="stack stack--tight">
        <% findings.each do |finding| %>
          <div class="card" style="padding: 0.6rem 0.8rem;">
            <div class="row" style="gap: 0.4rem;">
              <span class="badge badge--<%= finding["severity"] == "important" ? "danger" : finding["severity"] == "warning" ? "warning" : "info" %>">
                <%= finding["category"] %>
              </span>
            </div>
            <p class="text-sm mt-1 mb-0"><%= finding["message"] %></p>
            <p class="text-xs text-faint mb-0"><%= finding["suggestion"] %></p>
          </div>
        <% end %>
      </div>
      <% if attempt.review["summary"].present? %>
        <p class="text-xs text-faint mt-2 mb-0"><%= attempt.review["summary"] %></p>
      <% end %>
    <% end %>

    <% if attempt.passed? && challenge.explanation.present? %>
      <div class="verdict verdict--correct mt-3" style="display: block;">
        <strong>Why this works</strong>
        <p class="mb-0 mt-1" style="color: var(--text);"><%= challenge.explanation %></p>
      </div>
    <% end %>
  </div>
</section>
