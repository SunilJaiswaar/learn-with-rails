<% content_for :title, "Achievements" %>

<header class="mb-3">
  <h1 class="mb-0">Achievements</h1>
  <p class="text-muted text-sm mb-0">
    Every one of these rewards work you actually did. None can be earned by
    clicking through content.
  </p>
</header>

<% if @earned.any? %>
  <section class="mb-3">
    <h2>Earned</h2>
    <div class="grid grid--3">
      <% @earned.each do |record| %>
        <div class="card" style="border-color: var(--accent);">
          <div class="row" style="gap: 0.6rem; flex-wrap: nowrap;">
            <span style="font-size: 1.6rem;" aria-hidden="true"><%= record.achievement.icon %></span>
            <div style="min-width: 0;">
              <strong><%= record.achievement.name %></strong>
              <div class="text-xs text-muted"><%= record.achievement.description %></div>
              <div class="text-xs text-faint mt-1">
                <%= record.awarded_at.to_date.to_fs(:long) %>
                <% if record.achievement.xp_reward.positive? %>
                  · +<%= record.achievement.xp_reward %> XP
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </section>
<% end %>

<section>
  <h2>Still locked</h2>
  <% if @locked.any? %>
    <div class="grid grid--3">
      <% @locked.each do |achievement| %>
        <% current = @progress[achievement].to_i %>
        <% percent = [(current.to_f / achievement.threshold * 100).round, 100].min %>
        <div class="card" style="opacity: 0.85;">
          <div class="row" style="gap: 0.6rem; flex-wrap: nowrap;">
            <span style="font-size: 1.6rem; filter: grayscale(1);" aria-hidden="true">
              <%= achievement.icon %>
            </span>
            <div style="min-width: 0; flex: 1;">
              <strong><%= achievement.name %></strong>
              <div class="text-xs text-muted"><%= achievement.description %></div>
              <div class="meter meter--sm mt-2">
                <div class="meter__fill" style="width: <%= percent %>%"></div>
              </div>
              <div class="text-xs text-faint mt-1">
                <%= number_with_delimiter current %> / <%= number_with_delimiter achievement.threshold %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-muted text-sm">Every achievement is earned.</p>
  <% end %>
</section>
