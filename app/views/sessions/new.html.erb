<% content_for :title, "Sign in" %>

<div style="max-width: 400px; margin: 3rem auto;">
  <h1 class="text-center">Sign in to <%= product_name %></h1>
  <p class="text-muted text-center text-sm mb-3">Pick up where your streak left off.</p>

  <div class="card card--raised">
    <%= form_with url: login_path, method: :post do |form| %>
      <div class="field">
        <%= form.label :email, "Email" %>
        <%= form.email_field :email, value: @email, class: "input", required: true,
                             autocomplete: "email", autofocus: true %>
      </div>
      <div class="field">
        <%= form.label :password, "Password" %>
        <%= form.password_field :password, class: "input", required: true,
                                autocomplete: "current-password" %>
      </div>
      <%= form.submit "Sign in", class: "btn btn--primary btn--block" %>
    <% end %>
  </div>

  <p class="text-center text-sm mt-2">
    New here? <%= link_to "Create an account", signup_path %>
  </p>
</div>
