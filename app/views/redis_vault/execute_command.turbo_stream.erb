<%= turbo_stream.replace "redis-keys-panel" do %>
  <div class="card" id="redis-keys-panel" style="padding: 1.5rem;">
    <div class="row row--between" style="align-items: center; margin-bottom: 1rem;">
      <div class="row" style="align-items: center; gap: 0.6rem;">
        <span style="font-size: 1.5rem;">🧠</span>
        <h2 class="text-base" style="margin: 0;">Resident Keys in RAM (<%= @redis_keys.size %> keys)</h2>
      </div>
      <%= button_to "Reset Store", redis_vault_reset_path, method: :post, class: "btn btn--sm text-xs" %>
    </div>

    <div style="overflow-x: auto;">
      <table class="table" style="font-size: 0.85rem;">
        <thead>
          <tr>
            <th scope="col">Key</th>
            <th scope="col">Type</th>
            <th scope="col">Value</th>
            <th scope="col">TTL</th>
            <th scope="col">Memory</th>
          </tr>
        </thead>
        <tbody>
          <% @redis_keys.each do |k, data| %>
            <tr>
              <td class="mono font-bold text-accent"><%= k %></td>
              <td>
                <span class="badge badge--subtle"><%= data["type"] %></span>
              </td>
              <td class="mono text-xs">
                <%= data["type"] == "zset" ? data["value"].map { |i| "#{i['member']} (#{i['score']})" }.join(", ") : data["value"] %>
              </td>
              <td class="mono text-xs">
                <%= data["ttl"] == -1 ? "persist (∞)" : "#{data['ttl']}s" %>
              </td>
              <td class="mono text-xs text-faint"><%= data["bytes"] %> bytes</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>

<%= turbo_stream.update "cli-output" do %>
  <div class="code-panel__bar">Terminal Output</div>
  <pre class="mono" style="margin: 0; padding: 0.8rem; font-size: 0.8rem; color: var(--accent);"><%= @last_output %></pre>
<% end %>
