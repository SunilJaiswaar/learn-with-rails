<% content_for :title, "Redis Vault & Memory Visualizer" %>

<div class="stack stack--loose">
  <header class="page-header">
    <div class="stack stack--tight">
      <div class="row" style="align-items: center; gap: 0.6rem;">
        <span class="badge badge--accent">World 10</span>
        <span class="text-xs text-muted">In-Memory Data Store & Cache</span>
      </div>
      <h1 class="page-title">Redis Vault &amp; Memory Simulator</h1>
      <p class="page-lead">
        Inspect in-memory data structures (Strings, Hashes, Lists, Sets, Sorted Sets), watch TTL countdowns, test eviction, and blast live traffic against the Token Bucket rate limiter.
      </p>
    </div>
  </header>

  <div class="grid grid--3">
    <%# Column 1 & 2: Redis Memory Key Inspector & CLI %>
    <div class="stack stack--loose" style="grid-column: span 2;">
      <%# Live Redis Memory Table %>
      <div class="card" id="redis-keys-panel" style="padding: 1.5rem;">
        <div class="row row--between" style="align-items: center; margin-bottom: 1rem;">
          <div class="row" style="align-items: center; gap: 0.6rem;">
            <span style="font-size: 1.5rem;">🧠</span>
            <h2 class="text-base" style="margin: 0;">Resident Keys in RAM (<%= @redis_keys.size %> keys)</h2>
          </div>
          <%= button_to "Reset Store", redis_vault_reset_path, method: :post, class: "btn btn--sm text-xs" %>
        </div>

        <div style="overflow-x: auto;">
          <table class="table" style="font-size: 0.85rem;">
            <thead>
              <tr>
                <th scope="col">Key</th>
                <th scope="col">Type</th>
                <th scope="col">Value</th>
                <th scope="col">TTL</th>
                <th scope="col">Memory</th>
              </tr>
            </thead>
            <tbody>
              <% @redis_keys.each do |k, data| %>
                <tr>
                  <td class="mono font-bold text-accent"><%= k %></td>
                  <td>
                    <span class="badge badge--subtle"><%= data["type"] %></span>
                  </td>
                  <td class="mono text-xs">
                    <%= data["type"] == "zset" ? data["value"].map { |i| "#{i['member']} (#{i['score']})" }.join(", ") : data["value"] %>
                  </td>
                  <td class="mono text-xs">
                    <%= data["ttl"] == -1 ? "persist (∞)" : "#{data['ttl']}s" %>
                  </td>
                  <td class="mono text-xs text-faint"><%= data["bytes"] %> bytes</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <%# Interactive Redis CLI %>
      <div class="card" style="padding: 1.5rem;">
        <h3 class="text-sm uppercase text-muted" style="margin-top: 0; margin-bottom: 0.8rem;">Interactive Redis CLI</h3>
        <%= form_with url: redis_vault_execute_path, method: :post, data: { turbo_stream: true } do |f| %>
          <div class="row" style="gap: 0.6rem;">
            <div style="flex: 1; display: flex; align-items: center; background: var(--surface-subtle); border-radius: var(--radius-sm); border: 1px solid var(--border); padding: 0 0.8rem;">
              <span class="mono text-accent" style="margin-right: 0.5rem;">127.0.0.1:6379&gt;</span>
              <%= text_field_tag :command, nil, placeholder: "SET user:welcome \"Hello World!\" (or GET, HSET, INCR, EXPIRE)",
                                 class: "mono", style: "border: none; background: transparent; width: 100%; outline: none; padding: 0.6rem 0;" %>
            </div>
            <%= submit_tag "Execute", class: "btn btn--primary btn--sm" %>
          </div>
        <% end %>

        <div id="cli-output" class="code-panel mt-2" style="margin-bottom: 0;">
          <div class="code-panel__bar">Terminal Output</div>
          <pre class="mono" style="margin: 0; padding: 0.8rem; font-size: 0.8rem; color: var(--accent);"><%= @last_output || "Enter a Redis command above to run it against the simulated in-memory engine." %></pre>
        </div>
      </div>
    </div>

    <%# Column 3: Rate Limiting & Token Bucket Simulator %>
    <div class="stack stack--loose">
      <div class="card border-accent" style="padding: 1.5rem;">
        <div class="row row--between" style="align-items: center; margin-bottom: 0.8rem;">
          <h2 class="text-sm uppercase text-accent" style="margin: 0;">Token Bucket Rate Limiter</h2>
          <span class="badge badge--accent">Redis + Lua</span>
        </div>

        <p class="text-xs text-muted mb-2">
          Tokens refill at 1 token/sec up to capacity 10. Each incoming request consumes 1 token.
        </p>

        <div class="card card--subtle" style="padding: 1rem; text-align: center; margin-bottom: 1rem;">
          <span class="text-xs text-muted">Available Bucket Tokens:</span>
          <div class="mono text-accent" style="font-size: 2.2rem; font-weight: bold;">
            <%= @rate_limiter["tokens"] %> / <%= @rate_limiter["capacity"] %>
          </div>
          <div class="meter meter--sm mt-1" role="img" aria-label="Bucket tokens">
            <div class="meter__fill" style="width: <%= (@rate_limiter['tokens'].to_f / @rate_limiter['capacity']) * 100 %>%;"></div>
          </div>
        </div>

        <div class="row row--between text-xs mono text-muted mb-2">
          <span>Allowed: <strong class="text-success"><%= @rate_limiter["allowed"] %></strong></span>
          <span>Blocked (429): <strong class="text-danger"><%= @rate_limiter["blocked"] %></strong></span>
        </div>

        <div class="stack stack--tight">
          <%= button_to "Blast 1 Request (200 OK)", redis_vault_blast_path(count: 1), method: :post, class: "btn btn--sm", style: "width: 100%; justify-content: center;" %>
          <%= button_to "Blast 5 Concurrent Requests", redis_vault_blast_path(count: 5), method: :post, class: "btn btn--sm", style: "width: 100%; justify-content: center;" %>
          <%= button_to "Blast 15 Requests (Trigger 429)", redis_vault_blast_path(count: 15), method: :post, class: "btn btn--sm btn--primary", style: "width: 100%; justify-content: center;" %>
        </div>
      </div>

      <div class="card" style="padding: 1.2rem;">
        <h3 class="text-xs uppercase text-muted" style="margin-top: 0; margin-bottom: 0.6rem;">Redis Data Type Cheatsheet</h3>
        <ul class="text-xs text-muted" style="margin: 0; padding-left: 1.2rem;">
          <li><strong>Strings:</strong> Cache fragments, counters, locks (`SETNX`)</li>
          <li><strong>Hashes:</strong> Object attributes, user sessions</li>
          <li><strong>Lists:</strong> FIFO queue, recent activity stream</li>
          <li><strong>Sorted Sets:</strong> Leaderboards, sliding window rate limiter</li>
          <li><strong>Pub/Sub:</strong> Live ActionCable / chat broadcasts</li>
        </ul>
      </div>
    </div>
  </div>
</div>
