<% content_for :title, "Sidekiq Factory & Background Jobs" %>

<div class="stack stack--loose">
  <header class="page-header">
    <div class="stack stack--tight">
      <div class="row" style="align-items: center; gap: 0.6rem;">
        <span class="badge badge--accent">World 10</span>
        <span class="text-xs text-muted">Asynchronous Processing & Worker Fleet</span>
      </div>
      <h1 class="page-title">Sidekiq Factory &amp; Job Simulator</h1>
      <p class="page-lead">
        Visualize the lifecycle: <strong>Rails App → Redis → Priority Queues → Concurrency Workers → Dead Set</strong>. Learn concurrency, exponential backoff, and how to stop a catastrophic 10,000-job retry storm.
      </p>
    </div>
  </header>

  <%# Active Alert Banner if Incident is Triggered %>
  <% if @state["incident_active"] %>
    <div class="card border-danger" style="padding: 1.5rem; background: rgba(239, 68, 68, 0.08);">
      <div class="row row--between" style="align-items: center;">
        <div class="stack stack--tight">
          <div class="row" style="align-items: center; gap: 0.6rem;">
            <span style="font-size: 1.8rem;">🚨</span>
            <h2 class="text-base text-danger" style="margin: 0;">PRODUCTION INCIDENT: 10,000+ Jobs Stuck in Retry Storm!</h2>
          </div>
          <p class="text-xs text-muted" style="margin: 0.2rem 0 0;">
            Exception: <code class="mono text-danger"><%= @state["error_message"] %></code>
          </p>
          <p class="text-xs text-muted" style="margin: 0;">
            Workers are overwhelmed retrying failing SMS messages. Critical payment jobs are completely starved!
          </p>
        </div>
        <span class="badge badge--xp">+250 XP</span>
      </div>

      <%# Incident Resolution Selector %>
      <div class="card card--subtle mt-3" style="padding: 1.2rem;">
        <strong class="text-xs uppercase text-muted">Diagnose & Choose Remediation:</strong>
        <%= form_with url: sidekiq_factory_resolve_incident_path, method: :post, class: "mt-2" do |f| %>
          <div class="stack stack--tight text-xs mb-2">
            <label style="cursor: pointer;">
              <input type="radio" name="solution" value="just_restart"> Just restart the Sidekiq processes (will immediately crash again on restart)
            </label>
            <label style="cursor: pointer;">
              <input type="radio" name="solution" value="delete_all"> Drop the entire Redis database (loses customer payments and session data!)
            </label>
            <label style="cursor: pointer;">
              <input type="radio" name="solution" value="weighted_queues_circuit_breaker">
              <strong>Apply Circuit Breaker on failing SMS gateway + Assign strict queue priority weights (-q critical,5 -q default,2 -q mailers,1)</strong>
            </label>
          </div>
          <button type="submit" class="btn btn--sm btn--primary">Deploy Architectural Fix</button>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Pipeline Visualization Grid %>
  <div class="grid grid--3">
    <%# Stage 1: Rails App Enqueuer %>
    <div class="card" style="padding: 1.5rem; text-align: center;">
      <span style="font-size: 2.2rem;">💎</span>
      <h3 class="text-sm font-bold mt-1" style="margin-bottom: 0.4rem;">Rails Application</h3>
      <p class="text-xs text-muted mb-2">Pushes serialized JSON job payloads into Redis with <code>perform_async</code>.</p>
      <div class="stack stack--tight mt-2">
        <%= button_to "+ Enqueue 50 Emails", sidekiq_factory_enqueue_path(queue: "mailers", count: 50), method: :post, class: "btn btn--sm text-xs", style: "width: 100%; justify-content: center;" %>
        <%= button_to "+ Enqueue 10 Critical Payments", sidekiq_factory_enqueue_path(queue: "critical", count: 10), method: :post, class: "btn btn--sm text-xs", style: "width: 100%; justify-content: center;" %>
        <% unless @state["incident_active"] %>
          <%= button_to "⚡ Trigger 10,000 Retry Storm", sidekiq_factory_trigger_incident_path, method: :post, class: "btn btn--sm btn--danger text-xs", style: "width: 100%; justify-content: center;" %>
        <% end %>
      </div>
    </div>

    <%# Stage 2: Redis Queues Breakdown %>
    <div class="card border-accent" style="padding: 1.5rem;">
      <div class="row row--between" style="align-items: center; margin-bottom: 0.8rem;">
        <h3 class="text-sm uppercase text-accent" style="margin: 0;">Redis Priority Queues</h3>
        <span class="badge badge--subtle">In-Memory Lists</span>
      </div>

      <div class="stack stack--tight">
        <% @state["queues"].each do |q_name, count| %>
          <div class="card card--subtle" style="padding: 0.8rem;">
            <div class="row row--between" style="align-items: center;">
              <span class="mono text-xs font-bold text-accent"><%= q_name %></span>
              <span class="badge <%= count > 500 ? 'badge--danger' : 'badge--subtle' %>"><%= number_with_delimiter count %> enqueued</span>
            </div>
            <div class="meter meter--sm mt-1" role="img" aria-label="<%= count %> jobs">
              <div class="meter__fill <%= 'bg-danger' if count > 500 %>" style="width: <%= [count, 100].min %>%;"></div>
            </div>
          </div>
        <% end %>

        <div class="row row--between text-xs text-faint mt-1">
          <span>Retries: <strong class="text-danger"><%= number_with_delimiter @state["retries"] %></strong></span>
          <span>Dead Set: <strong><%= number_with_delimiter @state["dead"] %></strong></span>
        </div>
      </div>
    </div>

    <%# Stage 3: Worker Fleet & Concurrency %>
    <div class="card" style="padding: 1.5rem;">
      <div class="row row--between" style="align-items: center; margin-bottom: 0.8rem;">
        <h3 class="text-sm uppercase text-muted" style="margin: 0;">Worker Thread Pool</h3>
        <span class="badge badge--subtle">Concurrency: 5</span>
      </div>

      <div class="stack stack--tight">
        <% @state["workers"].each do |worker| %>
          <div class="card card--subtle" style="padding: 0.6rem 0.8rem;">
            <div class="row row--between" style="align-items: center;">
              <span class="mono text-xs font-bold">Thread #<%= worker["id"] %></span>
              <span class="badge <%= worker['status'] == 'busy' ? 'badge--accent' : 'badge--subtle' %> text-xs">
                <%= worker["status"].upcase %>
              </span>
            </div>
            <% if worker["job"] %>
              <div class="mono text-xs text-muted mt-1" style="font-size: 0.75rem;">
                <%= worker["job"] %> (<%= worker["queue"] %>)
              </div>
            <% else %>
              <div class="text-xs text-faint mt-1" style="font-size: 0.75rem;">Idle · Waiting for job</div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# Production Best Practices Table %>
  <div class="card" style="padding: 1.5rem;">
    <h3 class="text-sm uppercase text-muted" style="margin-top: 0; margin-bottom: 0.8rem;">Sidekiq Production Architecture Best Practices</h3>
    <div class="grid grid--3">
      <div class="card card--subtle" style="padding: 1rem;">
        <strong class="text-xs text-accent">1. Idempotency Keys</strong>
        <p class="text-xs text-muted mt-1" style="margin: 0;">
          Jobs must be safe to run twice. If a worker crashes mid-execution, Sidekiq will retry the job. Use database unique constraints or Redis lock tokens.
        </p>
      </div>
      <div class="card card--subtle" style="padding: 1rem;">
        <strong class="text-xs text-accent">2. Weighted Queues</strong>
        <p class="text-xs text-muted mt-1" style="margin: 0;">
          Never put email delivery in the same queue as financial transactions. Set weights: <code>bundle exec sidekiq -q critical,5 -q default,2 -q mailers,1</code>.
        </p>
      </div>
      <div class="card card--subtle" style="padding: 1rem;">
        <strong class="text-xs text-accent">3. Circuit Breaker</strong>
        <p class="text-xs text-muted mt-1" style="margin: 0;">
          When an external provider (Twilio, Stripe) returns 503s, fail fast with a circuit breaker rather than letting 10,000 workers block on socket timeouts.
        </p>
      </div>
    </div>
  </div>
</div>
