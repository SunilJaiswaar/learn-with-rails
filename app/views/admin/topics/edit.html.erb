<% content_for :title, "Edit #{@topic.name}" %>
<h1>Edit mission</h1>
<section class="card"><%= render "form", topic: @topic %></section>
<section class="card mt-3" style="border-color: var(--danger);">
  <h2>Delete</h2>
  <p class="text-sm text-muted">
    This removes the mission, its lessons and its blocks. Challenges and
    questions are kept but detached.
  </p>
  <%= button_to "Delete mission", admin_topic_path(@topic), method: :delete,
                class: "btn btn--danger",
                form: { data: { turbo_confirm: "Delete #{@topic.name}? This cannot be undone." } } %>
</section>
