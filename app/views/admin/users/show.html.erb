<% content_for :title, @user.name %>

<nav class="text-xs text-faint mb-2"><%= link_to "Learners", admin_users_path %></nav>

<header class="row row--between mb-3">
  <div>
    <h1 class="mb-0"><%= @user.name %></h1>
    <p class="text-sm text-muted mb-0"><%= @user.email %></p>
  </div>
  <div class="row">
    <span class="badge">Level <%= @user.level %></span>
    <span class="badge badge--accent"><%= number_with_delimiter @user.xp_total %> XP</span>
  </div>
</header>

<div class="grid grid--sidebar">
  <div class="stack">
    <section class="card card--flush">
      <div class="card__header"><h2>Measured mastery</h2></div>
      <div class="card__body">
        <% if @progresses.any? %>
          <table class="table">
            <thead>
              <tr>
                <th scope="col">Skill</th><th scope="col">Composite</th>
                <th scope="col">Weakest</th><th scope="col">Mastery</th>
              </tr>
            </thead>
            <tbody>
              <% @progresses.each do |progress| %>
                <tr>
                  <td><%= progress.skill.name %></td>
                  <td class="mono"><%= progress.composite_score %>%</td>
                  <td class="text-sm text-muted"><%= progress.weakest_dimension.to_s.humanize %></td>
                  <td><span class="badge"><%= progress.mastery_level.humanize %></span></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="text-sm text-muted mb-0">No evidence recorded.</p>
        <% end %>
      </div>
    </section>

    <section class="card card--flush">
      <div class="card__header"><h2>Recent attempts</h2></div>
      <div class="card__body">
        <% if @recent_attempts.any? %>
          <table class="table">
            <thead><tr><th scope="col">Challenge</th><th scope="col">Status</th><th scope="col">Tests</th><th scope="col">When</th></tr></thead>
            <tbody>
              <% @recent_attempts.each do |attempt| %>
                <tr>
                  <td class="text-sm"><%= attempt.challenge.title %></td>
                  <td><span class="badge badge--<%= attempt.passed? ? "success" : "danger" %>"><%= attempt.status %></span></td>
                  <td class="mono"><%= attempt.tests_passed %>/<%= attempt.tests_total %></td>
                  <td class="text-xs text-faint"><%= time_ago_in_words(attempt.created_at) %> ago</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="text-sm text-muted mb-0">No attempts yet.</p>
        <% end %>
      </div>
    </section>
  </div>

  <aside class="stack">
    <% if policy(@user).change_role? %>
      <section class="card">
        <h3>Role</h3>
        <%= form_with model: @user, url: admin_user_path(@user), method: :patch do |form| %>
          <div class="field">
            <%= form.label :role, "Assign role" %>
            <%= form.select :role, User.roles.keys.map { |r| [r.humanize, r] }, {},
                            class: "select" %>
          </div>
          <%= form.submit "Update role", class: "btn btn--primary btn--block" %>
        <% end %>
        <p class="text-xs text-faint mt-2 mb-0">
          Role changes are written to the audit log.
        </p>
      </section>
    <% else %>
      <section class="card">
        <h3>Role</h3>
        <p class="text-sm text-muted mb-0">
          <%= @user == current_user ? "You cannot change your own role." : "Admins only." %>
        </p>
      </section>
    <% end %>

    <section class="card">
      <h3>Account</h3>
      <dl class="text-sm" style="margin: 0;">
        <dt class="text-xs text-faint">Experience band</dt>
        <dd style="margin: 0 0 0.5rem;"><%= @user.experience_band_label %></dd>
        <dt class="text-xs text-faint">Streak</dt>
        <dd style="margin: 0 0 0.5rem;"><%= @user.display_streak %> days</dd>
        <dt class="text-xs text-faint">Last seen</dt>
        <dd style="margin: 0;">
          <%= @user.last_seen_at ? "#{time_ago_in_words(@user.last_seen_at)} ago" : "never" %>
        </dd>
      </dl>
    </section>
  </aside>
</div>
