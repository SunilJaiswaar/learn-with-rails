<% content_for :title, "Learners" %>

<form method="get" action="<%= admin_users_path %>" class="card mb-3"
      data-controller="autosubmit" data-action="input->autosubmit#submit">
  <label class="visually-hidden" for="user-search">Search learners</label>
  <input class="input" type="search" id="user-search" name="q" value="<%= params[:q] %>"
         placeholder="Search by name or email">
</form>

<section class="card card--flush">
  <table class="table">
    <thead>
      <tr>
        <th scope="col">Learner</th><th scope="col">Role</th><th scope="col">Level</th>
        <th scope="col">XP</th><th scope="col">Joined</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td>
            <%= link_to user.name, admin_user_path(user) %>
            <div class="text-xs text-faint"><%= user.email %></div>
          </td>
          <td><span class="badge <%= "badge--accent" if user.staff? %>"><%= user.role %></span></td>
          <td class="mono"><%= user.level %></td>
          <td class="mono"><%= number_with_delimiter user.xp_total %></td>
          <td class="text-xs text-faint"><%= user.created_at.to_date.to_fs(:long) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>

<div class="mt-3"><%= paginate @users %></div>
