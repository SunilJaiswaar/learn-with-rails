<%= turbo_stream.replace "challenge-result" do %>
  <div id="challenge-result">
    <%= render @challenge.sql_language? ? "challenges/sql_result" : "challenges/result",
               attempt: @attempt, result: @result, xp: @xp,
               challenge: @challenge, heading: "Result" %>
  </div>
<% end %>

<%# Hints may now be exhausted or the penalty changed, so refresh the panel. %>
<%= turbo_stream.replace "hint-panel" do %>
  <section class="card card--flush" id="hint-panel">
    <div class="card__header"><h3 class="mb-0">Hints</h3></div>
    <div class="card__body">
      <%= render "challenges/hints", challenge: @challenge, ladder: @ladder,
                 revealed: @ladder.revealed.ordered %>
    </div>
  </section>
<% end %>

<% if @xp.to_i.positive? %>
  <%= turbo_stream.append "toasts" do %>
    <%= render "shared/toast", title: "+#{@xp} XP",
               body: "Challenge solved: #{@challenge.title}", kind: :xp %>
  <% end %>
<% end %>

<% if @award&.levelled_up? %>
  <%= turbo_stream.append "toasts" do %>
    <%= render "shared/toast", title: "Level #{@award.new_level}",
               body: Gamification::LevelCurve.title_for(@award.new_level),
               kind: :level, timeout: 9000 %>
  <% end %>
<% end %>

<% Array(@award&.achievements).each do |achievement| %>
  <%= turbo_stream.append "toasts" do %>
    <%= render "shared/toast",
               title: "#{achievement.icon} #{achievement.name}",
               body: achievement.description, kind: :achievement, timeout: 9000 %>
  <% end %>
<% end %>
