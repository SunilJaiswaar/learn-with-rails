<% content_for :title, "Security Fortress & Vulnerability Labs" %>

<div class="stack stack--loose">
  <header class="page-header">
    <div class="stack stack--tight">
      <div class="row" style="align-items: center; gap: 0.6rem;">
        <span class="badge badge--accent">World 14</span>
        <span class="text-xs text-muted">Offensive &amp; Defensive Engineering</span>
      </div>
      <h1 class="page-title">Security Fortress</h1>
      <p class="page-lead">
        Safe interactive vulnerability labs. Test offensive attack payloads (SQLi, XSS, IDOR, Mass Assignment) in a simulated sandbox, observe how vulnerable code fails, and verify production-grade defensive fixes.
      </p>
    </div>
  </header>

  <%# Lab Selector Tabs %>
  <div class="row" style="gap: 0.8rem; overflow-x: auto; padding-bottom: 0.5rem;">
    <% SecurityLabController::LABS.each do |key, lab| %>
      <% active = (key == @active_lab) %>
      <%= link_to security_lab_path(lab: key),
                  class: "card card--interactive #{'border-accent bg-surface-accent' if active}",
                  style: "min-width: 180px; padding: 1rem; text-decoration: none;" do %>
        <div class="row" style="align-items: center; gap: 0.6rem;">
          <span style="font-size: 1.5rem;"><%= lab[:icon] %></span>
          <div>
            <strong class="text-sm <%= active ? 'text-accent' : 'text-default' %>" style="display: block;">
              <%= lab[:name] %>
            </strong>
            <span class="text-xs text-faint"><%= lab[:category] %></span>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="grid grid--3">
    <%# Column 1 & 2: Interactive Exploit & Defense Sandbox %>
    <div class="stack stack--loose" style="grid-column: span 2;">
      <div class="card" style="padding: 1.5rem;">
        <div class="row row--between" style="align-items: center; margin-bottom: 1rem;">
          <div class="row" style="align-items: center; gap: 0.6rem;">
            <span style="font-size: 1.6rem;"><%= @lab_data[:icon] %></span>
            <h2 class="text-base" style="margin: 0;"><%= @lab_data[:name] %></h2>
          </div>
          <span class="badge badge--subtle"><%= @lab_data[:category] %></span>
        </div>

        <p class="text-sm text-muted mb-3"><%= @lab_data[:explanation] %></p>

        <%# Code Comparison: Vulnerable vs Secured %>
        <div class="grid grid--2 mb-3">
          <div class="code-panel">
            <div class="code-panel__bar row row--between">
              <span class="text-danger">❌ Vulnerable Implementation</span>
            </div>
            <pre class="mono" style="margin: 0; padding: 0.8rem; font-size: 0.8rem; color: #f87171;"><%= @lab_data[:vulnerable_code] %></pre>
          </div>

          <div class="code-panel">
            <div class="code-panel__bar row row--between">
              <span class="text-success">✔ Secured Implementation</span>
            </div>
            <pre class="mono" style="margin: 0; padding: 0.8rem; font-size: 0.8rem; color: #34d399;"><%= @lab_data[:secure_code] %></pre>
          </div>
        </div>

        <%# Exploit Execution Console %>
        <%= form_with url: security_lab_exploit_path, method: :post, data: { turbo_stream: true } do |f| %>
          <%= hidden_field_tag :lab, @active_lab %>

          <div class="stack stack--tight">
            <label class="text-xs uppercase text-muted font-bold">Attack Payload Simulator:</label>
            <div class="row" style="gap: 0.6rem;">
              <%= text_field_tag :payload, @lab_data[:sample_payload],
                                 class: "mono", style: "flex: 1; padding: 0.6rem 0.8rem; font-size: 0.85rem;" %>
            </div>

            <div class="row row--between mt-2" style="align-items: center;">
              <div class="row" style="gap: 1rem; align-items: center;">
                <label style="cursor: pointer; display: flex; align-items: center; gap: 0.4rem;" class="text-xs">
                  <input type="radio" name="mode" value="vulnerable" checked> Run Against Vulnerable Code
                </label>
                <label style="cursor: pointer; display: flex; align-items: center; gap: 0.4rem;" class="text-xs">
                  <input type="radio" name="mode" value="secured"> Run Against Secured Code
                </label>
              </div>
              <button type="submit" class="btn btn--primary btn--sm">⚡ Fire Attack Payload</button>
            </div>
          </div>
        <% end %>

        <%# Output Target Panel %>
        <div id="exploit-output" class="code-panel mt-3" style="margin-bottom: 0;">
          <div class="code-panel__bar">Sandbox Result &amp; Defense Telemetry</div>
          <pre class="mono" style="margin: 0; padding: 1rem; font-size: 0.85rem; color: var(--accent);"><%= @result ? @result["output"] : "Click 'Fire Attack Payload' above to test the exploit in the simulated sandbox." %></pre>
        </div>
      </div>
    </div>

    <%# Column 3: Defense & OWASP Best Practices %>
    <div class="stack stack--loose">
      <div class="card border-accent" style="padding: 1.5rem;">
        <h3 class="text-sm uppercase text-accent" style="margin-top: 0; margin-bottom: 0.8rem;">Application Defense Checklist</h3>
        <ul class="text-xs text-muted" style="margin: 0; padding-left: 1.2rem;">
          <li style="margin-bottom: 0.4rem;"><strong>Never Interpolate:</strong> Always pass hash arguments to <code>ActiveRecord::Relation#where</code> to trigger bind params.</li>
          <li style="margin-bottom: 0.4rem;"><strong>Don't Trust User HTML:</strong> Avoid <code>html_safe</code> or <code>raw</code> on user content. Rely on automatic ERB escaping.</li>
          <li style="margin-bottom: 0.4rem;"><strong>Scope by Tenant:</strong> Always chain queries off <code>current_user</code> or use Pundit policy scopes to stop IDOR.</li>
          <li style="margin-bottom: 0.4rem;"><strong>Strong Parameters:</strong> Explicitly permit only expected mass-assignment attributes.</li>
        </ul>
      </div>

      <div class="card" style="padding: 1.2rem;">
        <span class="badge badge--xp">+150 XP</span>
        <p class="text-xs text-muted mt-2 mb-0">
          Running the payload against <strong>Secured Code</strong> verifies mitigation and grants Security Engineering mastery evidence.
        </p>
      </div>
    </div>
  </div>
</div>
