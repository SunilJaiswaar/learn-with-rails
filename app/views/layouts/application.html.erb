<!DOCTYPE html>
<html lang="en"
      <%= tag.attributes(data: { theme: (theme_preference unless theme_preference == "system"),
                                 reduced_motion: reduced_motion?.to_s }) %>>
  <head>
    <title><%= content_for(:title) ? "#{content_for(:title)} · #{product_name}" : product_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="description" content="<%= AppSetting['tagline'] %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag "application", "components", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <div class="app-shell">
      <%= render "shared/sidebar" %>

      <div class="main">
        <%= render "shared/topbar" %>

        <main id="main-content" class="content <%= yield(:content_class) %>" tabindex="-1">
          <%= render "shared/flash" %>
          <%= yield %>
        </main>
      </div>
    </div>

    <%# XP and achievement notifications are appended here by Turbo Streams. %>
    <div class="toast-stack" id="toasts" aria-live="polite" aria-atomic="false"></div>
  </body>
</html>
