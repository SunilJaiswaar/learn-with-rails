<div class="card" id="rails-challenges" style="padding: 1.5rem;">
  <div class="row row--between" style="align-items: baseline; margin-bottom: 0.4rem;">
    <h2 class="text-base mb-0">🎯 Which layer answered?</h2>
    <span class="badge <%= solved_slugs.size == challenges.size ? 'badge--success' : 'badge--subtle' %>">
      <%= solved_slugs.size %>/<%= challenges.size %> correct
    </span>
  </div>
  <p class="text-xs text-muted mb-2">
    Knowing Rails has middleware, a router and controllers is recall. Knowing
    which of them turned a request into a 404 is what makes a production log
    readable. One of these has no answer — that is deliberate.
  </p>

  <div class="stack stack--tight">
    <% challenges.each do |challenge| %>
      <% solved = solved_slugs.include?(challenge[:slug]) %>
      <% revealing = revealed_slug == challenge[:slug] %>
      <details class="card card--subtle" style="padding: 0.9rem;" <%= "open" if revealing || !solved %>>
        <summary class="row" style="gap: 0.5rem; cursor: pointer;">
          <span><%= solved ? "✅" : "⬜" %></span>
          <strong class="text-sm"><%= challenge[:title] %></strong>
          <span class="text-xs text-faint">+<%= challenge[:xp_reward] %> XP</span>
        </summary>

        <p class="text-sm" style="margin: 0.7rem 0;"><%= challenge[:prompt] %></p>

        <%= form_with url: rails_lab_solve_path, method: :post,
                      data: { turbo_stream: true } do |f| %>
          <%= f.hidden_field :slug, value: challenge[:slug] %>
          <div class="row" style="gap: 0.5rem; flex-wrap: wrap;">
            <%= f.select :stage,
                         options_for_select(
                           RailsLab::Challenges.options.map { |s| [ s.to_s.humanize, s ] },
                           revealing ? chosen : nil
                         ),
                         { include_blank: "Pick a layer" }, class: "text-sm" %>
            <%= f.submit solved ? "Answer again" : "Submit", class: "btn btn--primary btn--sm" %>
          </div>
        <% end %>

        <% if revealing %>
          <p class="text-xs <%= correct ? 'text-success' : 'text-danger' %>"
             style="margin: 0.8rem 0 0.3rem;">
            <%= correct ? "Correct." : "Not that layer." %>
          </p>
          <p class="text-xs text-muted mb-0"><%= challenge[:lesson] %></p>
        <% elsif solved %>
          <p class="text-xs text-muted" style="margin: 0.8rem 0 0;"><%= challenge[:lesson] %></p>
        <% end %>
      </details>
    <% end %>
  </div>
</div>
