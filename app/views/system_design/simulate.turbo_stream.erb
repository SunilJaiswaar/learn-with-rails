<%= turbo_stream.replace "simulation-results" do %>
  <%= render "system_design/simulation_results" %>
<% end %>

<% if @simulation.passed %>
  <%= turbo_stream.append "toasts" do %>
    <%= render "shared/toast",
               title: "System Design Challenge Solved! (+#{@challenge[:xp_reward]} XP)",
               body: "Resilient architecture verified under #{@rps} RPS production load.",
               kind: :xp %>
  <% end %>
<% end %>
